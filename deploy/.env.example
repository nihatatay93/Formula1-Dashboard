# Copy to deploy/.env on the host and fill in. Never commit the filled copy.
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#
# Every value here is required. The production compose file refuses to start
# rather than fall back to a default, so a missing secret is a startup error
# instead of a deployment that looks healthy while being open.

# The PostgreSQL role password.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# The dashboard sign-in password, stored as a PBKDF2 hash rather than in the
# clear, so this file does not hand over a password you may have reused.
#   cd backend && uv run python -m scripts.hash_password
DASHBOARD_PASSWORD_HASH=

# Signs session cookies and client bearer tokens. Rotating it signs out every
# browser and invalidates every issued token, which is the only way to revoke
# one.
#   openssl rand -hex 32
DASHBOARD_SECRET_KEY=

# From Cloudflare Zero Trust -> Networks -> Tunnels, after creating a tunnel
# and pointing a public hostname at http://web:8080.
TUNNEL_TOKEN=
