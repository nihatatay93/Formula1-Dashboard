# Front door for the deployed stack.
#
# Everything is served from one origin: the built dashboard at /, and the API
# under /api. That is not a convenience — it is what lets the session cookie
# keep working as written. Splitting the dashboard and the API across two
# hostnames would force SameSite=None and a CORS layer with credentials, which
# is where this class of bug lives.
#
# Cloudflare terminates TLS in front of this, so Caddy serves plain HTTP on an
# internal port and obtains no certificates of its own.

{
	admin off
	auto_https off
	# Cloudflare and the tunnel are the only things that reach this, so their
	# forwarded client address is the one worth logging.
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	# The API, including the live-timing WebSocket upgrade at
	# /api/v1/live/stream. Caddy proxies WebSockets without extra
	# configuration; the header block only preserves the original scheme and
	# host so the application can build correct absolute URLs.
	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# The dashboard is a single page with no client-side router, so a missing
	# path falls back to index.html rather than 404ing on a refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# Hashed asset filenames change on every build, so they can be cached
		# hard. index.html must not be, or a deploy would not be picked up.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@html path /index.html /
		header @html Cache-Control "no-cache"
	}

	header {
		# The dashboard loads no third-party code and talks only to itself.
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}
}
